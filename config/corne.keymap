
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
	combos {
		compatible = "zmk,combos";
		timeout-ms = <15>;
// -----------------------------------------------------------------------------------------
// |     ~     |     |     (     /     | | |     *      )      |      |     =     \ 
// < CAPS LOCK >     |     {     -     | | |     +      }      &      |     |     `
// |     |     |     |     [     !     | | |    "|"     ]      _      |     |     |
//                   |     |     |     | | |     |      |      |
		// row 1
		combo_tilde {
			key-positions = <0 1>;
			bindings = <&kp TILDE>;
		};
		combo_lparen {
			key-positions = <3 4>;
			bindings = <&kp LPAR>;
		};
		combo_div {
			key-positions = <4 5>;
			bindings = <&kp FSLH>;
		};
		combo_mul {
			key-positions = <6 7>;
			bindings = <&kp ASTERISK>;
		};
		combo_rparen {
			key-positions = <7 8>;
			bindings = <&kp RPAR>;
		};
		combo_eq {
			key-positions = <9 10>;
			bindings = <&kp EQL>;
		};
		combo_bslh {
			key-positions = <10 11>;
			bindings = <&kp BSLH>;
		};

		// row 2
		combo_clck {
			key-positions = <12 13 14>;
			bindings = <&kp CLCK>;
		};
		combo_lbrace {
			key-positions = <15 16>;
			bindings = <&kp LBRC>;
		};
		combo_minus {
			key-positions = <16 17>;
			bindings = <&kp MINUS>;
		};
		combo_plus {
			key-positions = <18 19>;
			bindings = <&kp PLUS>;
		};
		combo_rbrace {
			key-positions = <19 20>;
			bindings = <&kp RBRC>;
		};
		combo_amps {
			key-positions = <20 21>;
			bindings = <&kp AMPS>;
		};
		combo_bktk {
			key-positions = <22 23>;
			bindings = <&kp GRAVE>;
		};
		
		// row 3
		combo_lbracket {
			key-positions = <27 28>;
			bindings = <&kp LBKT>;
		};
		combo_excl {
			key-positions = <28 29>;
			bindings = <&kp EXCL>;
		};
		combo_pipe {
			key-positions = <30 31>;
			bindings = <&kp PIPE>;
		};
		combo_rbracket {
			key-positions = <31 32>;
			bindings = <&kp RBKT>;
		};
		combo_ul {
			key-positions = <32 33>;
			bindings = <&kp UNDER>;
		};

		// bluetooth
		combo_bt0 {
			timeout-ms = <500>;
			require-prior-idle-ms = <1000>;
			key-positions = <0 1 2 3 6>;
			bindings = <&bt BT_SEL 0>;
		};
		combo_bt1 {
			timeout-ms = <500>;
			require-prior-idle-ms = <1000>;
			key-positions = <0 1 2 3 7>;
			bindings = <&bt BT_SEL 1>;
		};
		combo_bt2 {
			timeout-ms = <500>;
			require-prior-idle-ms = <1000>;
			key-positions = <0 1 2 3 8>;
			bindings = <&bt BT_SEL 2>;
		};
		combo_bt_clear {
			timeout-ms = <500>;
			require-prior-idle-ms = <1000>;
			key-positions = <0 1 2 3 11>;
			bindings = <&bt BT_CLR>;
		};

		// mouse mode
		combo_mouse_mode {
			require-prior-idle-ms = <500>;
			key-positions = <38 39>;
			bindings = <&to 3>;

		};
	};

	td_caps: td_caps {
		compatible = "zmk,behavior-tap-dance";
		#binding-cells = <0>;
		tapping-term-ms = <250>;
		bindings = <&none>, <&caps_word>;
	};

	td_btsel: td_btsel {
		compatible = "zmk,behavior-tap-dance";
		#binding-cells = <0>;
		tapping-term-ms = <250>;
		bindings = <&none>, <&sl 6>;
	};

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |   E  |  R  |  T  |   |  Y  |  U    |  I  |  O  |  P  | BKSP |
// |  ESC |  A  |  S  |   D  |  F  |  G  |   |  H  |  J    |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |   C  |  V  |  B  |   |  N  |  M    |  ,  |  .  |  /  | MO2  |
//                    | LALT | MO1 | SPC |   | ENT | RCTRL | RGUI |
                        display-name = "Base";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E    &kp R &kp T       &kp Y   &kp U     &kp I     &kp O   &kp P    &kp BSPC
   &kp ESC   &kp A &kp S &kp D    &kp F &kp G       &kp H   &kp J     &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C    &kp V &kp B       &kp N   &kp M     &kp COMMA &kp DOT &kp FSLH &mo 2
                         &kp LALT &mo 1 &kp SPACE   &kp RET &kp RCTRL &kp RGUI
                        >;
                };

                lower_layer {
// ---------------------------------------------------------------------------------------
// |  ^  |  1  |  2  |  3  |  4  |  5   | | |   6  |   7  |   8  |   9   |  0  | DEL |
// |  ^  | MB3 | MB2 | M_U | MB1 | PGUP | | | HOME | LEFT |  UP  | RIGHT |  ^  |  ^  |
// |  ^  |  ^  | M_L | M_D | M_R | PGDN | | |  END |   ^  | DOWN |   ^   |  ^  |  ^  |
//                   |  ^  |  ^  |  ^   | | |   ^  |   ^  |   ^  |
                        display-name = "Lower";
                        bindings = <
   &trans &kp N1   &kp N2         &kp N3         &kp N4          &kp N5     &kp N6   &kp N7   &kp N8   &kp N9    &kp N0 &kp DEL
   &trans &mkp MB3 &mkp MB2       &mmv MOVE_UP   &mkp MB1        &kp PGUP   &kp HOME &kp LEFT &kp UP   &kp RIGHT &trans &trans
   &trans &trans   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &kp PGDN   &kp END  &trans   &kp DOWN &trans    &trans &trans
                          	  &trans         &trans          &trans     &trans   &trans   &trans
                        >;
                };

		fkey_layer {
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |     |  F1  |  F2  |  F3  |  F4 |    |
// |      |     |     |     |     |     |   |     |  F5  |  F6  |  F7  |  F8 |    |
// |  ^   |     |     |     |     |     |   |     |  F9  |  F10 | F11  | F12 |    |
//                    |  ^  |     |     |   |     |   ^  |   ^  |
                        display-name = "F-key layer";
                        bindings = <
   &none  &none &none &none  &none &none         &none &kp F1 &kp  F2 &kp  F3 &kp  F4 &none
   &none  &none &none &none  &none &none         &none &kp F5 &kp  F6 &kp  F7 &kp  F8 &none
   &trans &none &none &none  &none &none         &none &kp F9 &kp F10 &kp F11 &kp F12 &none
		      &trans &none &none         &none &trans &trans
                        >;
		};

                mouse_layer {
// -----------------------------------------------------------------------------------------
// |     |   | SCR_L | M_3 | SCR_R |       | | |       | SCR_L | M_3 | SCR_R |    | TO0 |
// | TO0 |   |  M_2  | M_U |  M_1  | SCR_U | | | SCR_U |  M_L  | M_U |  M_R  |    |     |
// |     |   |  M_L  | M_D |  M_R  | SCR_D | | | SCR_D |  M_1  | M_D |  M_2  |    |     |
//                   |     |  TO0  |       | | |       |       |     |
                        display-name = "Mouse layer";
                        bindings = <
   &none &none &msc SCRL_LEFT &mkp MB3       &msc SCRL_RIGHT &none          &none          &msc SCRL_LEFT &mkp MB3       &msc SCRL_RIGHT &none &to 0
   &to 0 &none &mkp MB2       &mmv MOVE_UP   &mkp MB1        &msc SCRL_UP   &msc SCRL_UP   &mmv MOVE_LEFT &mmv MOVE_UP   &mmv MOVE_RIGHT &none &none
   &none &none &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN &msc SCRL_DOWN &mkp MB1       &mmv MOVE_DOWN &mkp MB2        &none &none
		              &none          &to 0           &none          &none          &none          &to 4
                        >;
                };

                hrm_0 {
// -----------------------------------------------------------------------------------------
// | TAB  | 1(Q)  | 2(W)  | 3(E)  | 4(R)  | 5(T) |   | 6(Y) | 7(U)  | 8(I)  | 9(O)  | 0(P)  | BKSP  |
// | ESC  | LS(A) | RC(S) | LA(D) | LG(F) | G    |   | H    | J     | K     | L     | ;     |  '    |
// | caps | Z     | X     | C     | V     | B    |   | N    | RG(M) | RA(,) | RC(.) | RS(/) | btsel |
//                               | | MO(5) | SPC |   | RET | MO(5) | |
			display-name = "Home-Row Mods 0";
			bindings = <
   &kp TAB  &mt N1 Q    &mt N2 W    &mt N3 E   &mt N4 R   &mt N5 T &mt N6 Y &mt N7 U   &mt N8 I       &mt N9 O      &mt N0 P       &kp BSPC
   &kp ESC  &mt LSHFT A &mt LCTRL S &mt LALT D &mt LGUI F &kp G    &kp H    &kp J      &kp K          &kp L         &kp SEMI       &kp SQT
   &td_caps &kp Z       &kp X       &kp C      &kp V      &kp B    &kp N    &mt RGUI M &mt RALT COMMA &mt RCTRL DOT &mt RSHFT FSLH &td_btsel
                                              &none &mo 5 &kp SPC  &kp RET &mo 5 &none
 			>;
                };

                hrm_1 {
// -----------------------------------------------------------------------------------------
// | LG  | 1   | 2   | 3   | 4   | 5    |   | 6    | 7    | 8    | 9     | 0  | DEL |
// | LSH | MB3 | MB2 | M_U | MB1 | PGUP |   | HOME | LEFT | UP   | RIGHT | ^  | RSH |
// | LC  | LA  | M_L | M_D | M_R | PGDN |   | END  | ^    | DOWN | ^     | RA | RC  |
//                          | ^ | ^ | ^ |   | ^ | ^ | ^ |
			display-name = "Home-Row Mods 1";
			bindings = <
    &kp LGUI  &kp N1   &kp N2         &kp N3         &kp N4          &kp N5   &kp N6   &kp N7   &kp N8   &kp N9    &kp N0   &kp DEL
    &kp LSHFT &mkp MB3 &mkp MB2       &mmv MOVE_UP   &mkp MB1        &kp PGUP &kp HOME &kp LEFT &kp UP   &kp RIGHT &trans   &kp RSHFT
    &kp LCTRL &kp LALT &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &kp PGDN &kp END  &trans   &kp DOWN &trans    &kp RALT &kp RCTRL
                                             &trans &trans &trans &trans &trans &trans
			>;
                };

                hrm_2 {
// -----------------------------------------------------------------------------------------
// | | BT_SEL 1 | BT_SEL_2 | BT_SEL_3 | BT_SEL_4 | |   | | | | | | | BT_CLR |
// | |          |          |          |          | |   | | | | | | |        |
// | |          |          |          |          | |   | | | | | | | RESET  |
//                                           | | | |   | | | |
			display-name = "Home-Row Mods 2";
			bindings = <
    &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none &none &none &none &none &none &bt BT_CLR
    &none &none        &none        &none        &none        &none &none &none &none &none &none &none 
    &none &none        &none        &none        &none        &none &none &none &none &none &none &sys_reset
                                           &none &none &none &none &none &none 
			>;
		};
        };
};

&mt {
	tapping-term-ms = <300>;
	flavor = "tap-preferred";
};
