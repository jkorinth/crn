#include <behaviors/battery_percentage_printer.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";
        timeout-ms = <15>;

        // row 1

        combo_tilde {
            key-positions = <1 2>;
            bindings = <&kp TILDE>;
        };

        combo_lparen {
            key-positions = <3 4>;
            bindings = <&kp LPAR>;
        };

        combo_div {
            key-positions = <4 5>;
            bindings = <&kp FSLH>;
        };

        combo_mul {
            key-positions = <6 7>;
            bindings = <&kp ASTERISK>;
        };

        combo_rparen {
            key-positions = <7 8>;
            bindings = <&kp RPAR>;
        };

        combo_eq {
            key-positions = <9 8>;
            bindings = <&kp EQUAL>;
        };

        combo_bslh {
            key-positions = <33 34>;
            bindings = <&kp BSLH>;
        };

        // row 2

        combo_lbrace {
            key-positions = <15 16>;
            bindings = <&kp LBRC>;
        };

        combo_minus {
            key-positions = <16 17>;
            bindings = <&kp MINUS>;
        };

        combo_plus {
            key-positions = <18 19>;
            bindings = <&kp PLUS>;
        };

        combo_rbrace {
            key-positions = <19 20>;
            bindings = <&kp RBRC>;
        };

        combo_amps {
            key-positions = <20 21>;
            bindings = <&kp AMPS>;
        };

        combo_bktk {
            key-positions = <22 21 20>;
            bindings = <&kp GRAVE>;
        };

        // row 3

        combo_lbracket {
            key-positions = <27 28>;
            bindings = <&kp LBKT>;
        };

        combo_excl {
            key-positions = <28 29>;
            bindings = <&kp EXCL>;
        };

        combo_pipe {
            key-positions = <30 31>;
            bindings = <&kp PIPE>;
        };

        combo_rbracket {
            key-positions = <31 32>;
            bindings = <&kp RBKT>;
        };

        combo_ul {
            key-positions = <32 33>;
            bindings = <&kp UNDER>;
        };

        // bluetooth

        combo_bt0 {
            timeout-ms = <500>;
            require-prior-idle-ms = <1000>;
            key-positions = <1 2 3 6 4>;
            bindings = <&bt BT_SEL 0>;
        };

        combo_bt1 {
            timeout-ms = <500>;
            require-prior-idle-ms = <1000>;
            key-positions = <1 2 3 7 4>;
            bindings = <&bt BT_SEL 1>;
        };

        combo_bt2 {
            timeout-ms = <500>;
            require-prior-idle-ms = <1000>;
            key-positions = <1 2 3 8 4>;
            bindings = <&bt BT_SEL 2>;
        };

        combo_bt_clear {
            timeout-ms = <500>;
            require-prior-idle-ms = <1000>;
            key-positions = <1 2 3 11 4>;
            bindings = <&bt BT_CLR>;
        };

        // mouse mode

        combo_mouse_mode {
            require-prior-idle-ms = <500>;
            key-positions = <38 39>;
            bindings = <&to 1>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <14 15 16>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
            require-prior-idle-ms = <75>;
        };

        combo_lshft {
            bindings = <&ht_sticky LSHFT LSHFT>;
            key-positions = <13 15>;
        };

        combo_lctrl {
            bindings = <&ht_sticky LCTRL LCTRL>;
            key-positions = <14 16>;
        };

        combo_lalt {
            bindings = <&ht_sticky LALT LALT>;
            key-positions = <13 16>;
        };

        combo_rshft {
            bindings = <&ht_sticky RSHFT RSHFT>;
            key-positions = <22 20>;
        };

        combo_rctrl {
            bindings = <&ht_sticky RCTRL RCTRL>;
            key-positions = <19 21>;
        };

        combo_ralt {
            bindings = <&ht_sticky RALT RALT>;
            key-positions = <22 19>;
        };

        combo_lgui {
            bindings = <&ht_sticky LGUI LGUI>;
            key-positions = <25 28>;
        };

        combo_rgui {
            bindings = <&ht_sticky RGUI RGUI>;
            key-positions = <34 31>;
        };

        combo_bspc {
            bindings = <&kp BSPC>;
            key-positions = <19 20 21>;
        };

        combo_sqt {
            bindings = <&kp SQT>;
            key-positions = <22 21>;
        };
    };

    td_caps: td_caps {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <250>;
        bindings = <&kp Z>, <&caps_word>;
    };

    td_btsel: td_btsel {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <250>;
        bindings = <&none>, <&sl 0>;
    };

    ht_sticky: ht_sticky {
        compatible = "zmk,behavior-hold-tap";
        label = "HT_STICKY";
        bindings = <&kp>, <&sk>;

        #binding-cells = <2>;
        tapping-term-ms = <175>;
        flavor = "balanced";
    };

    td_flayer: td_flayer {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_FLAYER";
        #binding-cells = <0>;
        bindings = <&mo 1>, <&tog 2>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        hrm_0 {
            display-name = "Home-Row Mods 0";
            bindings = <
&none  &mt N1 Q  &mt N2 W  &mt N3 E  &mt N4 R  &mt N5 T     &mt N6 Y  &mt N7 U    &mt N8 I   &mt N9 O  &mt N0 P  &none
&none  &kp A     &kp S     &kp D     &kp F     &kp G        &kp H     &kp J       &kp K      &kp L     &kp SEMI  &none
&none  &td_caps  &kp X     &kp C     &kp V     &kp B        &kp N     &kp M       &kp COMMA  &kp DOT   &kp FSLH  &none
                           &none     &mo 1     &kp SPACE    &kp RET   &td_flayer  &none
            >;
        };

        hrm_1 {
            display-name = "Home-Row Mods 1";
            bindings = <
&none  &kp N1    &kp N2          &kp N3          &kp N4           &kp N5       &kp N6    &kp N7    &kp N8    &kp N9     &kp N0    &none
&none  &mkp MB3  &mkp MB2        &mmv MOVE_UP    &mkp MB1         &kp PG_UP    &kp HOME  &kp LEFT  &kp UP    &kp RIGHT  &trans    &none
&none  &kp LALT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp PG_DN    &kp END   &trans    &kp DOWN  &trans     &kp RALT  &none
                                 &bapp           &trans           &trans       &trans    &trans    &bapp
            >;
        };

        flayer {
            bindings = <
&trans  &mt F11 F1  &mt F12 F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &trans      &trans      &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans      &trans      &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans   &trans
                                &trans  &tog 3  &trans    &trans  &tog 2  &trans
            >;
        };

        game {
            bindings = <
&trans  &kp Q  &kp W  &kp E             &kp ESC       &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp A  &kp S  &kp D             &kp TAB       &kp LGUI     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp Z  &kp X  &kp C_PLAY_PAUSE  &kp LCTRL     &kp LSHFT    &sl 2   &trans  &trans  &trans  &trans  &trans
                      &trans            &kp LEFT_ALT  &trans       &trans  &tog 3  &trans
            >;
        };
    };
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

&sk { release-after-ms = <5000>; };
